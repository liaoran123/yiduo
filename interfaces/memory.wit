// 数据类型
enum DataType {
  F32,
  F64,
  I32,
  I64,
}

// 存算数据块对象
resource compute_buffer {
  // 创建一个存算缓冲区（指定大小和类型）
  static constructor(size: u32, dtype: DataType) -> result<compute_buffer, Error>
  
  // 将数据上传到存算阵列
  upload(data: list<u8>) -> result<unit, Error>
  
  // 从存算阵列下载结果
  download() -> result<list<u8>, Error>
  
  // 在存算阵列上执行矩阵运算
  matmul(rhs: compute_buffer) -> result<compute_buffer, Error>
}
