// 输入硬件接口

use base.types.{result, list, option}
use base.error.{Error}
use yiduo:capabilities.{power_saving, diagnostics, firmware_update}

package yiduo:unihal;

/// 输入设备属性
record input_property {
    key: string,
    value: string,
}

/// 输入设备信息
record input_device_info {
    vendor_id: u32,
    device_id: u32,
    device_type: string,
    model: string,
    // 预留字段：未来如果增加了新的配置项，不需要修改接口定义
    extensions: list<input_property>,
}

/// 输入事件
variant input_event {
    // 键盘事件
    KeyPress(string),
    KeyRelease(string),
    KeyRepeat(string),
    // 鼠标事件
    MouseMove(u32, u32),
    MousePress(u32, u32, u32),
    MouseRelease(u32, u32, u32),
    MouseScroll(i32),
    // 触摸事件
    TouchDown(u32, u32, u32),
    TouchMove(u32, u32, u32),
    TouchUp(u32, u32),
    // 预留扩展
    Custom(string, list<u8>),
}

/// 输入设备资源
resource input_device {
    /// 获取输入事件
    /// @return 事件列表
    get_events: func() -> result<list<input_event>, Error>
    
    /// 检查按键状态
    /// @param key 按键名称
    is_key_pressed: func(key: string) -> result<bool, Error>
    
    /// 获取设备信息
    get_info: func() -> result<input_device_info, Error>
    
    /// 获取设备属性
    get_properties: func() -> result<list<input_property>, Error>
    
    /// 关闭输入设备
    close: func() -> result<unit, Error>

    // 组合能力模块
    power_saving: power_saving
    diagnostics: diagnostics
    firmware_update: firmware_update
}

/// 输入能力接口
interface input {
    /// 打开输入设备
    /// @param device_path 设备路径或标识符
    /// @return 输入设备句柄
    open: func(device_path: string) -> result<input_device, Error>
    
    /// 获取所有可用的输入设备
    /// @return 设备路径列表
    enumerate_devices: func() -> result<list<string>, Error>
}

// 输入设备世界
world input {
  import input
}
