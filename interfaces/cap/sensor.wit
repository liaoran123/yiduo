// 传感器硬件接口

use base.types.{result, buffer}
use base.error.{Error}

// 传感器数据
type sensor_data = {
  timestamp: u64,
  values: list<f32>,
}

// 摄像头帧
type camera_frame = {
  width: u32,
  height: u32,
  format: string,
  data: buffer,
}

// 传感器接口
interface sensor {
  // 初始化传感器
  init: func() -> result<unit, Error>
  // 读取传感器数据
  read_data: func() -> result<sensor_data, Error>
  // 获取传感器信息
  get_info: func() -> result<{name: string, type: string, range: {min: f32, max: f32}}, Error>
  // 设置传感器参数
  set_param: func(name: string, value: f32) -> result<unit, Error>
  // 关闭传感器
  deinit: func() -> result<unit, Error>
}

// 摄像头接口
interface camera {
  // 初始化摄像头
  init: func() -> result<unit, Error>
  // 捕获帧
  capture: func() -> result<camera_frame, Error>
  // 获取摄像头信息
  get_info: func() -> result<{name: string, resolution: {width: u32, height: u32}, formats: list<string>}, Error>
  // 设置摄像头参数
  set_param: func(name: string, value: string) -> result<unit, Error>
  // 关闭摄像头
  deinit: func() -> result<unit, Error>
}

// 传感器设备世界
world sensor {
  import sensor
  import camera
}
