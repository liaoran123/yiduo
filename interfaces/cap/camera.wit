// 摄像头接口

use base.types.{result, list}
use base.error.{Error}
use yiduo:capabilities.{power_saving, secure_element, diagnostics, firmware_update}

package yiduo:unihal;

/// 图像数据
type image = list<u8>;

/// 摄像头参数
record camera_params {
    resolution: string,
    framerate: u32,
    exposure: u32,
    gain: u32
}

/// 摄像头信息
record camera_info {
    vendor_id: u32,
    device_id: u32,
    model: string,
    supported_resolutions: list<string>
}

/// 摄像头资源
resource camera_device {
    /// 捕获图像
    capture: func() -> result<image, Error>
    
    /// 开始录制
    start_recording: func() -> result<unit, Error>
    
    /// 停止录制
    stop_recording: func() -> result<unit, Error>
    
    /// 设置参数
    set_params: func(params: camera_params) -> result<unit, Error>
    
    /// 获取参数
    get_params: func() -> result<camera_params, Error>
    
    /// 获取设备信息
    get_info: func() -> result<camera_info, Error>
    
    /// 关闭摄像头
    close: func() -> result<unit, Error>
    
    // 组合能力模块
    power_saving: power_saving
    secure_element: secure_element
    diagnostics: diagnostics
    firmware_update: firmware_update
}

/// 摄像头能力接口
interface camera {
    /// 打开摄像头
    open: func() -> result<camera_device, Error>
    
    /// 枚举所有可用的摄像头
    enumerate_cameras: func() -> result<list<camera_info>, Error>
}

// 摄像头世界
world camera {
  import camera
}
