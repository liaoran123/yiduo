/// 组件管理器接口：用于管理 Native 和 Wasm 组件的加载、切换和生命周期
/// 
/// 这个接口提供了一多 OS 的核心能力：
/// 1. 组件类型识别（Native vs Wasm）
/// 2. 动态组件加载和替换
/// 3. 组件生命周期管理
/// 4. 配置驱动的组件选择

package unihal:component-manager

/// 组件类型枚举
enum component-type {
  /// WebAssembly 组件（安全、可移植、热更新）
  wasm,
  /// Native 组件（高性能、无安全边界）
  native,
  /// 自动选择（根据运行时环境和性能要求自动选择）
  auto
}

/// 组件状态枚举
enum component-status {
  /// 组件已注册但未加载
  registered,
  /// 组件正在加载中
  loading,
  /// 组件已加载并可用
  active,
  /// 组件已卸载
  unloaded,
  /// 组件加载失败
  failed
}

/// 组件信息结构体
record component-info {
  /// 组件唯一标识
  id: string,
  /// 组件名称
  name: string,
  /// 组件版本
  version: string,
  /// 组件类型
  component-type: component-type,
  /// 组件路径或加载地址
  location: string,
  /// 当前状态
  status: component-status,
  /// 依赖的其他组件 ID
  dependencies: list<string>,
  /// 元数据（自定义键值对）
  metadata: list<tuple<string, string>>
}

/// 组件加载选项
record component-load-options {
  /// 强制使用特定的组件类型（如果不指定则使用配置默认值）
  force-component-type: option<component-type>,
  /// 是否启用性能监控
  enable-performance-monitoring: bool,
  /// 是否启用安全检查（仅对 Wasm 有效）
  enable-sandbox: bool,
  /// 超时时间（毫秒）
  timeout-ms: option<u32>,
  /// 自定义加载参数
  custom-params: list<tuple<string, string>>
}

/// 组件选择策略
enum selection-strategy {
  /// 优先使用 Wasm（安全优先）
  prefer-wasm,
  /// 优先使用 Native（性能优先）
  prefer-native,
  /// 根据当前系统负载动态选择
  adaptive,
  /// 根据配置文件选择
  config-driven
}

/// 组件监控信息
record component-monitoring-info {
  /// 组件 ID
  component-id: string,
  /// 启动时间戳（毫秒）
  start-time-ms: u64,
  /// 内存使用量（字节）
  memory-usage-bytes: u64,
  /// CPU 使用率（0.0 - 1.0）
  cpu-usage: float32,
  /// 调用次数
  call-count: u64,
  /// 平均响应时间（微秒）
  avg-response-time-us: u32,
  /// 是否在沙箱中运行
  in-sandbox: bool
}

world component-manager {
  /// --- 组件注册与发现 ---

  /// 注册一个组件（可以是 Native 库或 Wasm 组件）
  /// 返回组件 ID
  register-component: func(info: component-info) -> result<string, error>

  /// 注销一个组件
  unregister-component: func(component-id: string) -> result<unit, error>

  /// 获取所有已注册的组件列表
  list-components: func() -> result<list<component-info>, error>

  /// 获取指定组件的信息
  get-component-info: func(component-id: string) -> result<component-info, error>

  /// --- 组件加载与卸载 ---

  /// 加载一个组件（根据选择策略决定是用 Native 还是 Wasm）
  load-component: func(
    component-id: string,
    options: option<component-load-options>
  ) -> result<unit, error>

  /// 卸载一个组件
  unload-component: func(component-id: string) -> result<unit, error>

  /// 热切换组件类型（在线升级，不中断服务）
  /// 从当前类型切换到目标类型
  hot-swap-component: func(
    component-id: string,
    target-type: component-type
  ) -> result<unit, error>

  /// --- 组件选择策略 ---

  /// 设置全局组件选择策略
  set-selection-strategy: func(strategy: selection-strategy) -> result<unit, error>

  /// 获取当前全局组件选择策略
  get-selection-strategy: func() -> result<selection-strategy, error>

  /// 为特定组件设置选择策略
  set-component-strategy: func(
    component-id: string,
    strategy: selection-strategy
  ) -> result<unit, error>

  /// --- 组件生命周期管理 ---

  /// 获取组件当前状态
  get-component-status: func(component-id: string) -> result<component-status, error>

  /// 重启一个组件
  restart-component: func(component-id: string) -> result<unit, error>

  /// 检查组件是否健康
  check-component-health: func(component-id: string) -> result<bool, error>

  /// --- 性能监控 ---

  /// 获取组件监控信息
  get-monitoring-info: func(component-id: string) -> result<component-monitoring-info, error>

  /// 获取所有组件的监控信息
  list-monitoring-info: func() -> result<list<component-monitoring-info>, error>

  /// --- 配置驱动 ---

  /// 从配置文件加载组件配置
  load-config: func(config-path: string) -> result<unit, error>

  /// 保存当前组件配置到文件
  save-config: func(config-path: string) -> result<unit, error>

  /// 重新加载配置并应用组件选择
  reload-config: func() -> result<unit, error>
}
