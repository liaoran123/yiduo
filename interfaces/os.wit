// interfaces/os.wit
// 操作系统标准接口定义

// 内存管理接口
interface memory {
  // 分配内存
  alloc: func(size: u32) -> result<u32, string>
  // 释放内存
  free: func(ptr: u32) -> result<unit, string>
}

// 文件系统接口
interface filesystem {
  // 读取文件
  read: func(path: string) -> result<string, string>
  // 写入文件
  write: func(path: string, content: string) -> result<unit, string>
}

// 网络接口
interface network {
  // 启动 TCP 服务器
  start_tcp_server: func(port: u16) -> result<u32, string>
  // 发送数据
  send_data: func(socket: u32, data: string) -> result<u32, string>
}

// NPU 推理接口
interface npu {
  // 执行推理
  infer: func(model_path: string, input_data: list<float32>) -> result<list<float32>, string>
}

// 操作系统主接口
world os {
  import memory
  import filesystem
  import network
  import npu
}