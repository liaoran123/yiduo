{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MoonBit Run",
      "type": "shell",
      "command": "moon",
      "args": ["run"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "MoonBit Test",
      "type": "shell",
      "command": "moon",
      "args": ["test"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}