// 一多操作系统 - 细胞组合器演示
// 核心思想：用户可以自由组合细胞，创建自己的定制化OS

///| 重复分隔符
fn repeat_sep(n: Int) -> String {
    let mut result = ""
    let mut i = 0
    while i < n {
        result = result + "="
        i = i + 1
    }
    result
}

///| 主程序
