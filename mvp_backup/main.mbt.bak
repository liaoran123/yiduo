// 一多操作系统 - MVP 演示
// 配置驱动 + 计算细胞 + 组合式设计

// ================== 核心接口 (链式骨架) ==================

/// 计算细胞基础 trait
trait Component {
  fn name(self) -> String
  fn init(self) -> Result[Unit, String]
  fn cleanup(self) -> Unit
}

/// 能力积木 trait
trait Capability {
  fn capability_name(self) -> String
  fn execute(self, input: String) -> Result[String, String]
}

// ================== 组件注册表 ==================

struct ComponentRegistry {
  mut capabilities: Map[String, Capability]
  mut custom_settings: Map[String, String]
}

fn ComponentRegistry::new() -> ComponentRegistry {
  {
    capabilities: Map.empty(),
    custom_settings: Map.empty(),
  }
}

fn ComponentRegistry::register_capability(self, cap: Capability) -> Unit {
  self.capabilities.set(cap.capability_name(), cap)
  println("✓ 注册能力: " + cap.capability_name())
}

fn ComponentRegistry::get_capability(self, name: String) -> Option[Capability] {
  self.capabilities.get(name)
}

fn ComponentRegistry::list_capabilities(self) -> Array[String] {
  self.capabilities.keys()
}

// ================== 应用配置结构 ==================

struct AppConfig {
  app_name: String
  enabled_capabilities: Array[String]
  capability_order: Array[String]
  custom_settings: Map[String, String]
}

fn AppConfig::default() -> AppConfig {
  {
    app_name: "MVP App",
    enabled_capabilities: Array.empty(),
    capability_order: Array.empty(),
    custom_settings: Map.empty(),
  }
}

// ================== 简单的配置加载器 ==================

fn load_config_from_string(yaml_str: String) -> Result[AppConfig, String] {
  let mut config = AppConfig::default()
  let lines = yaml_str.split("\n")
  
  let mut current_section = ""
  
  for line in lines {
    let trimmed = line.trim()
    
    if trimmed == "" || trimmed.starts_with("#") {
      continue
    }
    
    if trimmed.ends_with(":") && !trimmed.starts_with("-") {
      current_section = trimmed.slice(0, trimmed.length() - 1)
      continue
    }
    
    if trimmed.starts_with("- ") {
      let value = trimmed.slice(2, trimmed.length())
      
      if current_section == "enabled_capabilities" {
        config.enabled_capabilities.push(value)
      } else if current_section == "capability_order" {
        config.capability_order.push(value)
      }
      continue
    }
    
    if let Some(colon_pos) = trimmed.index_of(":") {
      let key = trimmed.slice(0, colon_pos).trim()
      let value = trimmed.slice(colon_pos + 1, trimmed.length()).trim()
      
      let mut clean_value = value
      if value.starts_with("\"") && value.ends_with("\"") && value.length() >= 2 {
        clean_value = value.slice(1, value.length() - 1)
      }
      
      match current_section {
        | "" => {
          match key {
            | "app_name" => config.app_name = clean_value,
            | _ => ()
          }
        }
        | "custom_settings" => {
          config.custom_settings.set(key, clean_value)
        }
        | _ => ()
      }
    }
  }
  
  Ok(config)
}

fn print_config(config: AppConfig) -> Unit {
  println("\n📋 应用配置: " + config.app_name)
  println("   启用能力: " + config.enabled_capabilities.join(", "))
  println("   执行顺序: " + config.capability_order.join(" -> "))
}

// ================== 能力流水线执行器 ==================

fn execute_pipeline(
  config: AppConfig,
  registry: ComponentRegistry,
  input: String
) -> Result[String, String] {
  println("\n🚀 开始执行流水线...")
  println("   输入: " + input)
  
  let mut current = input
  let mut step = 1
  
  for cap_name in config.capability_order {
    match registry.get_capability(cap_name) {
      | Some(cap) => {
        println("\n   步骤 " + step.to_string() + ": 执行 " + cap_name)
        match cap.execute(current) {
          | Ok(result) => {
            println("      输出: " + result)
            current = result
            step = step + 1
          }
          | Err(e) => {
            println("      ✗ 错误: " + e)
            return Err("能力执行失败 " + cap_name + ": " + e)
          }
        }
      }
      | None => {
        return Err("找不到能力: " + cap_name)
      }
    }
  }
  
  println("\n✅ 流水线执行完成!")
  Ok(current)
}

// ================== 能力积木 (树形器官) ==================

// --- 问候能力 ---
struct Greeter {
  greeting: String
}

fn Greeter::new(greeting: String) -> Greeter {
  { greeting: greeting }
}

impl Component for Greeter {
  fn name(self) -> String { "greeter" }
  fn init(self) -> Result[Unit, String] { Ok(()) }
  fn cleanup(self) -> Unit {}
}

impl Capability for Greeter {
  fn capability_name(self) -> String { "greeter" }
  fn execute(self, input: String) -> Result[String, String] {
    Ok(self.greeting + ", " + input + "!")
  }
}

// --- 日志能力 ---
struct Logger {
  level: String
}

fn Logger::new(level: String) -> Logger {
  { level: level }
}

impl Component for Logger {
  fn name(self) -> String { "logger" }
  fn init(self) -> Result[Unit, String] { Ok(()) }
  fn cleanup(self) -> Unit {}
}

impl Capability for Logger {
  fn capability_name(self) -> String { "logger" }
  fn execute(self, input: String) -> Result[String, String] {
    let level_str = match self.level {
      | "info" => "INFO"
      | "warn" => "WARN"
      | "error" => "ERROR"
      | _ => "INFO"
    }
    println("[" + level_str + "] " + input)
    Ok(input)
  }
}

// --- 格式化能力 ---
struct Formatter {
  format: String
}

fn Formatter::new(format: String) -> Formatter {
  { format: format }
}

impl Component for Formatter {
  fn name(self) -> String { "formatter" }
  fn init(self) -> Result[Unit, String] { Ok(()) }
  fn cleanup(self) -> Unit {}
}

fn to_titlecase(s: String) -> String {
  if s.length() == 0 {
    return s
  }
  let first = s.slice(0, 1).to_upper()
  let rest = s.slice(1, s.length()).to_lower()
  first + rest
}

impl Capability for Formatter {
  fn capability_name(self) -> String { "formatter" }
  fn execute(self, input: String) -> Result[String, String] {
    match self.format {
      | "uppercase" => Ok(input.to_upper())
      | "lowercase" => Ok(input.to_lower())
      | "titlecase" => Ok(to_titlecase(input))
      | _ => Err("Unknown format: " + self.format)
    }
  }
}

// --- 图像处理能力 ---
struct ImageProcessor {
  operation: String
}

fn ImageProcessor::new(operation: String) -> ImageProcessor {
  { operation: operation }
}

impl Component for ImageProcessor {
  fn name(self) -> String { "image_processor" }
  fn init(self) -> Result[Unit, String] { Ok(()) }
  fn cleanup(self) -> Unit {}
}

impl Capability for ImageProcessor {
  fn capability_name(self) -> String { "image_processor" }
  fn execute(self, input: String) -> Result[String, String] {
    let result = match self.operation {
      | "grayscale" => "Grayscale[" + input + "]"
      | "blur" => "Blur[" + input + "]"
      | "resize" => "Resize[" + input + "]"
      | "edge_detect" => "EdgeDetect[" + input + "]"
      | _ => "Process[" + self.operation + "][" + input + "]"
    }
    Ok(result)
  }
}

// ================== 主应用 ==================

fn main() -> Unit {
  println("═══════════════════════════════════════════════════════════════")
  println("    一多操作系统 - MVP 演示")
  println("    配置驱动 + 计算细胞 + 组合式设计")
  println("═══════════════════════════════════════════════════════════════")

  // --- 1. 初始化注册表 ---
  println("\n📦 阶段 1: 初始化组件注册表")
  println("   注册能力积木...")
  
  let registry = ComponentRegistry::new()
  registry.register_capability(Greeter::new("Hello"))
  registry.register_capability(Logger::new("info"))
  registry.register_capability(Formatter::new("uppercase"))
  registry.register_capability(ImageProcessor::new("grayscale"))
  
  println("\n✨ 已注册的能力积木:")
  for name in registry.list_capabilities() {
    println("   - " + name)
  }

  // --- 2. 加载 Hello World 配置 ---
  println("\n📄 阶段 2: 加载应用配置")
  
  let hello_config_yaml = """
app_name: "Hello MVP"
enabled_capabilities:
  - "logger"
  - "greeter"
  - "formatter"
capability_order:
  - "logger"
  - "greeter"
  - "formatter"
custom_settings:
  greeter.greeting: "Hello"
  formatter.format: "uppercase"
  logger.level: "info"
"""
  
  match load_config_from_string(hello_config_yaml) {
    | Ok(hello_config) => {
      print_config(hello_config)

      // --- 3. 执行流水线 ---
      println("\n🎯 演示 1: Hello World (默认配置)")
      match execute_pipeline(hello_config, registry, "World") {
        | Ok(result) => println("\n🎊 最终结果: " + result)
        | Err(e) => println("\n✗ 执行失败: " + e)
      }
    }
    | Err(e) => println("✗ 加载配置失败: " + e)
  }

  // --- 4. 演示：修改配置 ---
  println("\n" + "═".repeat(60))
  println("🎯 演示 2: 修改配置 - 改变问候语和格式")
  println("   (无需改代码，只需改配置!)")
  
  let hello_config_yaml_v2 = """
app_name: "Hello MVP v2"
enabled_capabilities:
  - "logger"
  - "greeter"
  - "formatter"
capability_order:
  - "logger"
  - "greeter"
  - "formatter"
custom_settings:
  greeter.greeting: "Hi"
  formatter.format: "lowercase"
  logger.level: "warn"
"""
  
  match load_config_from_string(hello_config_yaml_v2) {
    | Ok(hello_config_v2) => {
      print_config(hello_config_v2)
      
      match execute_pipeline(hello_config_v2, registry, "MoonBit") {
        | Ok(result) => println("\n🎊 最终结果: " + result)
        | Err(e) => println("\n✗ 执行失败: " + e)
      }
    }
    | Err(e) => println("✗ 加载配置失败: " + e)
  }

  // --- 5. 演示：智能摄像头 ---
  println("\n" + "═".repeat(60))
  println("🎯 演示 3: 智能摄像头 - 图像处理流水线")
  
  let camera_config_yaml = """
app_name: "Smart Camera MVP"
enabled_capabilities:
  - "logger"
  - "image_processor"
  - "formatter"
capability_order:
  - "logger"
  - "image_processor"
  - "formatter"
custom_settings:
  image_processor.operation: "edge_detect"
  formatter.format: "titlecase"
  logger.level: "info"
"""
  
  match load_config_from_string(camera_config_yaml) {
    | Ok(camera_config) => {
      print_config(camera_config)
      
      match execute_pipeline(camera_config, registry, "raw_image_001.jpg") {
        | Ok(result) => println("\n🎊 最终结果: " + result)
        | Err(e) => println("\n✗ 执行失败: " + e)
      }
    }
    | Err(e) => println("✗ 加载配置失败: " + e)
  }

  // --- 完成 ---
  println("\n" + "═".repeat(60))
  println("✅ MVP 演示完成!")
  println("\n📝 核心要点:")
  println("   1. 链式骨架: 固定的 Component/Capability trait 接口")
  println("   2. 树形器官: 可插拔的能力积木 (greeter, logger, formatter, etc.)")
  println("   3. 配置即编程: YAML 文件定义能力组合和执行顺序")
  println("   4. 计算细胞: 每个能力都是独立的功能单元")
  println("\n🚀 下一步: 加入 Wasm 组件支持、真实硬件接口...")
  println("═══════════════════════════════════════════════════════════════")
}
